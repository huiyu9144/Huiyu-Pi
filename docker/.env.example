# =============================================================================
# Huiyu Pi — Docker Environment Configuration
# =============================================================================
# Copy this file to .env and edit:
#   cp docker/.env.example docker/.env
#
# Then start:
#   cd docker && docker compose up -d --build
# =============================================================================

# --- Host Port ---
# Port on your host machine (default: 9144)
HOST_PORT=9144

# --- Volume Mounts ---
# Workspace directory (project files the agent operates on)
WORKSPACE_HOST_PATH=./workspace

# pi CLI config directory (shared auth.json, settings.json)
PI_CONFIG_HOST_PATH=~/.pi/agent

# Huiyu Pi state directory (sessions, projects, MCP config)
FORGE_DATA_HOST_PATH=~/.huiyu-pi

# --- Auth ---
# Set a password to protect the web UI
UI_PASSWORD=

# Require password change on first login
REQUIRE_PASSWORD_CHANGE=false

# JWT secret for session tokens (auto-generated if empty)
JWT_SECRET=

# Static API key for server-to-server auth
API_KEY=

# --- Container Resource Limits ---
# Memory limit (docker-compose mem_limit)
# MEM_LIMIT=2g

# CPU limit (docker-compose cpus)
# CPUS=1.0

# --- Container User ---
# UID/GID for the 'pi' user inside the container.
# Set to match your host user to avoid permission issues on bind mounts:
#   docker compose build --build-arg PUID=$(id -u) --build-arg PGID=$(id -g)
PUID=1000
PGID=1000
