{
  "name": "huiyu-pi",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "Self-hosted browser workbench for the pi coding agent — a webui frontend for pi and the coding agent ecosystem",
  "keywords": [
    "huiyu",
    "pi",
    "pi-forge",
    "piweb",
    "pi-web",
    "pi-web-ui",
    "piwebui",
    "pi-webui",
    "webui",
    "agent",
    "ai-agent",
    "ai-tools",
    "skill",
    "agent-skills",
    "agent-harness",
    "harness",
    "harness-engineering",
    "coding-agent",
    "self-hosted",
    "local-ai",
    "code-assistant",
    "terminal",
    "ide",
    "browser-ide",
    "claude",
    "openai",
    "deepseek",
    "anthropic"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "huiyu-pi": "bin/huiyu-pi.mjs"
  },
  "scripts": {
    "postinstall": "node bin/fix-pty-perms.mjs",
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently \"cross-env PORT=9144 npm run dev -w packages/server\" \"cross-env PORT=9144 npm run dev -w packages/client\"",
    "dev:remote": "concurrently \"cross-env HOST=0.0.0.0 PORT=9144 npm run dev -w packages/server\" \"cross-env PORT=9144 npm run dev -w packages/client -- --host\"",
    "typecheck": "npm run check --workspaces --if-present && tsc -p tests/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "test": "scripts/run-tests.sh",
    "test:ci": "scripts/run-tests.sh --ci",
    "build:site": "node scripts/build-site.mjs",
    "build:publish": "npm run build && node scripts/build-publish-dir.mjs",
    "publish:npm": "npm run build:publish && cd publish && npm publish"
  },
  "overrides": {
    "serialize-javascript": ">=6.0.2",
    "qs": ">=6.15.2",
    "tmp": ">=0.2.6",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "marked": "^18.0.4",
    "prettier": "^3.5.3",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
