{
  "name": "@huiyu-pi/client",
  "version": "1.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:restart": "node -e \"const{execSync:c}=require('child_process'),p=9145;try{if(process.platform==='win32'){execSync('netstat -ano|findstr :'+p,{encoding:'utf8'}).split('\\n').forEach(l=>{const m=l.match(/\\s+(\\d+)\\s*$/);if(m)try{process.kill(+m[1],'SIGTERM')}catch(e){}})}else{execSync('lsof -ti tcp:'+p,{encoding:'utf8'}).trim().split('\\n').forEach(id=>{if(id)try{process.kill(+id,'SIGKILL')}catch(e){}})}}catch(e){}\" & vite",
    "build": "tsc && vite build",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.2",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-java": "^6.0.1",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/lang-python": "^6.1.7",
    "@codemirror/lang-rust": "^6.0.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^5.5.0",
    "codemirror": "^6.0.1",
    "hash-wasm": "^4.12.0",
    "katex": "^0.17.0",
    "lucide-react": "^1.16.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.6",
    "react-diff-view": "^3.2.2",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "refractor": "^5.0.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-pwa": "^1.3.0"
  }
}
